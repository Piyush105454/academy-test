# ==========================================
# Grading Agent Environment Variables
# ==========================================

# 1. Supabase Credentials
# Used to save the AI feedback back to the database
# Make sure to use your SERVICE_ROLE_KEY (admin key), NOT the anon/publishable key!
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 2. OpenAI Credentials
# Used to grade the handwritten notes via the openai-agents SDK
OPENAI_API_KEY="sk-proj-..."

# 3. Google Drive Service Account
# Used to bypass "Restricted" sharing settings and download student images natively
# Make sure your private key is formatted exactly as it is in your JSON file (including the literal \n characters or real newlines)
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIB...-----END PRIVATE KEY-----\n"
